{
  // Cloudflare Worker for the realtime backend (docs/realtime/rebuild-spec.md §2, §10, §11).
  // Local: `npm run dev:server` (offline, no account). Deploy: documented only; never from CI tasks.
  // The default (dev) env has its own name, so a deploy that forgets `--env production` creates a
  // separate `prime-daifugo-rt-dev` Worker instead of replacing production with the dev vars.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "prime-daifugo-rt-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "LOBBY", "class_name": "LobbyDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO", "LobbyDO"] }],
  // Dev defaults; `worker/.dev.vars` (gitignored) or `wrangler dev --var KEY:VALUE` override them.
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,http://localhost:3123,http://localhost:3124",
    "GRACE_PLAYING_MS": "120000",
    "GRACE_IDLE_MS": "60000",
    "AWAY_TURN_CAP_MS": "20000",
    "ROOM_TTL_IDLE_MS": "600000",
    "ROOM_TTL_ACTIVE_MS": "1800000"
  },
  "env": {
    "production": {
      "name": "prime-daifugo-rt",
      "workers_dev": true,
      // Bindings and vars are not inherited by named environments; repeat them here.
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "RoomDO" },
          { "name": "LOBBY", "class_name": "LobbyDO" }
        ]
      },
      "vars": {
        // Production domains (Vercel project prime-daifugo) and its preview deployments.
        "ALLOWED_ORIGINS": "https://prime-daifugo.jp,https://www.prime-daifugo.jp,https://prime-daifugo.vercel.app,https://prime-daifugo-*.vercel.app",
        "GRACE_PLAYING_MS": "120000",
        "GRACE_IDLE_MS": "60000",
        "AWAY_TURN_CAP_MS": "20000",
        "ROOM_TTL_IDLE_MS": "600000",
        "ROOM_TTL_ACTIVE_MS": "1800000"
      }
    }
  }
}
