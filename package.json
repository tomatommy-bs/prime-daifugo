{
  "name": "prime-daifugo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,rt \"next dev\" \"npm:dev:server\"",
    "dev:web": "next dev",
    "dev:server": "WRANGLER_SEND_METRICS=false wrangler dev -c worker/wrangler.jsonc --port 8787 --local --persist-to .wrangler/state",
    "build": "next build",
    "start": "next start",
    "biome": "biome lint --apply src && biome format --write src",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p worker",
    "test:integration": "INTEGRATION=1 vitest run --project integration",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "deploy:server": "wrangler deploy -c worker/wrangler.jsonc --env production",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "STORYBOOK_TESTS=1 vitest run --project storybook",
    "test:coverage": "vitest run --project unit --coverage",
    "screens": "node scripts/screens.mjs",
    "flights": "node scripts/flights.mjs",
    "biome:ci": "biome ci src worker e2e"
  },
  "dependencies": {
    "@mantine/core": "^8.1.1",
    "@mantine/hooks": "^8.1.1",
    "@mantine/notifications": "^8.1.1",
    "@tabler/icons-react": "^3.26.0",
    "@vercel/analytics": "^1.4.1",
    "framer-motion": "^12.0.0",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "next": "^14.2.9",
    "primes-and-factors": "^1.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-qr-code": "^2.0.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@chromatic-com/storybook": "^3.2.6",
    "@cloudflare/workers-types": "5.20261110.1",
    "@playwright/test": "1.53.0",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-onboarding": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/experimental-addon-test": "8.6.14",
    "@storybook/experimental-nextjs-vite": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/test": "8.6.14",
    "@tailwindcss/postcss": "^4.1.10",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.0.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/browser": "^3.1.3",
    "@vitest/coverage-v8": "^3.1.3",
    "concurrently": "10.0.7",
    "fast-check": "4.10.2",
    "jsdom": "^26.0.0",
    "playwright": "^1.52.0",
    "postcss": "^8.4.49",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "storybook": "8.6.14",
    "tailwindcss": "^4.1.10",
    "typescript": "^5",
    "vitest": "^3.1.3",
    "wrangler": "4.160.0"
  }
}
